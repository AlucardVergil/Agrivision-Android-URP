  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Ants are eusocial insects of the family Formicidae and, along with the
    related wasps and bees, belong to the order Hymenoptera. Ants evolved from vespoid
    wasp ancestors in the Cretaceous period. More than 13,800 of an estimated total
    of 22,000 species have been classified. They are easily identified by their geniculate
    (elbowed) antennae and the distinctive node-like structure that forms their slender
    waists.

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
